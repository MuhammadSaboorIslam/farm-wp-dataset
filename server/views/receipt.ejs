<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Receipt <%= number %> - FarmDirect</title>
  <style>
    body { font-family: Arial, Helvetica, sans-serif; color: #1f2937; margin: 0; background: #f3faf5; }
    .page { max-width: 720px; margin: 24px auto; background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; }
    header { background: #15803d; color: #fff; padding: 20px 28px; display: flex; justify-content: space-between; align-items: center; }
    header h1 { margin: 0; font-size: 22px; }
    main { padding: 24px 28px; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px; font-size: 14px; }
    .label { color: #6b7280; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 4px; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th { text-align: left; color: #6b7280; font-weight: normal; border-bottom: 2px solid #e5e7eb; padding: 8px 0; }
    td { border-bottom: 1px solid #f0f0f0; padding: 10px 0; }
    .num { text-align: right; white-space: nowrap; }
    .total td { border: 0; font-size: 16px; font-weight: bold; padding-top: 14px; }
    .status { display: inline-block; background: #dcfce7; color: #166534; border-radius: 999px; padding: 2px 10px; font-size: 12px; font-weight: bold; }
    footer { padding: 16px 28px; background: #f9fafb; color: #6b7280; font-size: 12px; }
    .hint { display: block; margin-top: 6px; color: #15803d; font-weight: bold; }
    @media print { .hint { display: none; } body { background: #fff; } .page { border: 0; margin: 0; max-width: none; } header { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }
  </style>
</head>
<body>
  <div class="page">
    <header>
      <h1>&#127806; FarmDirect</h1>
      <div style="text-align:right"><div style="font-size:18px;font-weight:bold">Receipt <%= number %></div><div style="font-size:13px;opacity:.9"><%= placed %></div></div>
    </header>
    <main>
      <div class="grid">
        <div><div class="label">From</div><b><%= order.farmer.farmName %></b><br><%= order.farmer.location %></div>
        <div><div class="label">Deliver to</div><b><%= order.customer.name %></b><br><%= order.address %><br><%= order.phone %></div>
        <div><div class="label">Status</div><span class="status"><%= status %></span></div>
        <div><div class="label">Payment</div>Cash on delivery</div>
      </div>
      <table>
        <thead><tr><th>Item</th><th class="num">Qty</th><th class="num">Price</th><th class="num">Amount</th></tr></thead>
        <tbody>
          <% order.items.forEach(function (it) { %>
            <tr><td><%= it.name %></td><td class="num"><%= it.qty %> <%= it.unit %></td><td class="num"><%= money(it.price) %></td><td class="num"><%= money(it.price * it.qty) %></td></tr>
          <% }) %>
          <tr><td colspan="3" class="num">Delivery</td><td class="num">Free</td></tr>
          <tr class="total"><td colspan="3" class="num">Total</td><td class="num"><%= money(order.total) %></td></tr>
        </tbody>
      </table>
    </main>
    <footer>Thank you for buying straight from the farm. Printed <%= printed %>.<span class="hint"> Press Ctrl+P (or &#8984;P on a Mac) to print or save as PDF.</span></footer>
  </div>
</body>
</html>
